# Copy to .env and pick ONE provider. Swapping models needs no code changes.
#   ollama    - local model, no API key, data never leaves the machine (default)
#   xai       - Grok via api.x.ai
#   anthropic - Claude
#   openai    - OpenAI
#   offline   - no model; deterministic rule-based agents
LLM_PROVIDER=ollama

# Leave blank for the provider default (ollama: qwen2.5:7b, xai: grok-3, anthropic: claude-sonnet-5-5, openai: gpt-4o-mini)
LLM_MODEL=

OLLAMA_BASE_URL=http://localhost:11434/v1
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# If the model is unreachable, degrade to offline rules instead of failing
LLM_FALLBACK_TO_OFFLINE=true
LLM_TIMEOUT_S=120

# Approval policy (USD)
VP_REVIEW_THRESHOLD=10000
CFO_THRESHOLD=50000
PRICE_VARIANCE_TOLERANCE=0.10
