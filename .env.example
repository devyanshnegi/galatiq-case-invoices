# Copy to .env and pick ONE provider. Swapping models needs no code changes.
#   ollama    - local model, no API key, data never leaves the machine (default)
#   xai       - Grok via api.x.ai
#   anthropic - Claude
#   openai    - OpenAI
#   offline   - no model; deterministic rule-based agents
LLM_PROVIDER=ollama

# Leave blank for the provider default (ollama: qwen2.5:7b, xai: grok-3, anthropic: claude-sonnet-5-5, openai: gpt-4o-mini)
LLM_MODEL=

OLLAMA_BASE_URL=http://localhost:11434/v1
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# If the model is unreachable, degrade to offline rules instead of failing
LLM_FALLBACK_TO_OFFLINE=true
LLM_TIMEOUT_S=120

# Approval policy (USD)
VP_REVIEW_THRESHOLD=10000
CFO_THRESHOLD=50000
PRICE_VARIANCE_TOLERANCE=0.10

# ---- Volume & integration ----
# Skip LLM deliberation when the policy allows only one outcome (clean -> pay, blocked -> reject)
FAST_PATH=true
# Invoices processed concurrently in queue/watch mode (and --all --workers N)
WORKERS=4
# local = ERP + bank tools in-process; mcp = separate acme-erp / acme-bank MCP servers
TOOLS_BACKEND=local
# Enforced by the bank (MCP server or local), not by the agents
BANK_SINGLE_PAYMENT_LIMIT=50000
# Optional second-opinion model for extractions the primary model can't verify
LLM_SECONDARY_PROVIDER=
LLM_SECONDARY_MODEL=
